{
  "_comment": "Shared fixtures for the to-do grammar. Read by src/lib/todo-model.test.ts (TypeScript) and Tests/ParkerCoreTests (Swift). Change here, and both suites move together.",
  "order": [
    "TODO",
    "DOING",
    "PAUSE",
    "WAIT",
    "ATTN",
    "DONE",
    "FAIL",
    "CANCEL"
  ],
  "aliases": {
    "WIP": "DOING",
    "PAUSED": "PAUSE",
    "HOLD": "PAUSE",
    "WAITING": "WAIT",
    "BLOCKED": "WAIT",
    "MISSED": "FAIL",
    "DISMISSED": "CANCEL"
  },
  "notTags": [
    "/WAITER x",
    "/PAUSES x",
    "/HOLDING x",
    "/DO x",
    "/TODOS x",
    "TODO x",
    "x /TODO"
  ],
  "click": {
    "completes": [
      "TODO",
      "DOING",
      "PAUSE",
      "WAIT",
      "ATTN"
    ],
    "reopens": [
      "DONE",
      "FAIL",
      "CANCEL"
    ],
    "altCycle": [
      "TODO",
      "DOING",
      "PAUSE",
      "WAIT",
      "ATTN",
      "FAIL",
      "CANCEL"
    ],
    "altFromDone": "ATTN"
  },
  "cursorCases": [
    {
      "name": "an empty line, cursor at the start",
      "text": "",
      "head": 0,
      "want": 6
    },
    {
      "name": "existing text, cursor at the start",
      "text": "buy milk",
      "head": 0,
      "want": 6
    },
    {
      "name": "existing text, cursor mid-word",
      "text": "buy milk",
      "head": 5,
      "want": 11
    }
  ],
  "sweepDocs": {
    "no trailing newline": "# list\n\n\nfirst\nsecond\nthird",
    "trailing newline": "# list\n\n\nfirst\nsecond\nthird\n",
    "already tagged": "/TODO first\n/DOING second\n/PAUSE third\n/WAIT fourth\n/ATTN fifth\n/DONE sixth",
    "indented": "  buy milk\n    call bank\nship"
  },
  "ownerCases": [
    {
      "name": "gives a to-do's nested lines to it",
      "lines": [
        "/DOING Ship it",
        "  - a detail",
        "  - another"
      ],
      "want": [
        null,
        "DOING",
        "DOING"
      ]
    },
    {
      "name": "ends the group when the text steps back out",
      "lines": [
        "/DONE Shipped",
        "  - a detail",
        "back at the margin"
      ],
      "want": [
        null,
        "DONE",
        null
      ]
    },
    {
      "name": "hands the group over at the next to-do",
      "lines": [
        "/DONE Shipped",
        "  - hers",
        "/TODO Next",
        "  - his"
      ],
      "want": [
        null,
        "DONE",
        null,
        "TODO"
      ]
    },
    {
      "name": "reads through a blank line inside a group",
      "lines": [
        "/WAIT On them",
        "  - one",
        "",
        "  - two"
      ],
      "want": [
        null,
        "WAIT",
        null,
        "WAIT"
      ]
    },
    {
      "name": "nests a to-do inside a to-do",
      "lines": [
        "/DOING Outer",
        "  - outer detail",
        "  /TODO Inner",
        "    - inner detail",
        "  - back to outer"
      ],
      "want": [
        null,
        "DOING",
        null,
        "TODO",
        "DOING"
      ]
    },
    {
      "name": "normalises an alias before handing it down",
      "lines": [
        "/WIP Ship it",
        "  - a detail"
      ],
      "want": [
        null,
        "DOING"
      ]
    },
    {
      "name": "owns nothing when there is no to-do above",
      "lines": [
        "Just a heading",
        "  - a detail"
      ],
      "want": [
        null,
        null
      ]
    },
    {
      "name": "counts deeper indentation as still inside",
      "lines": [
        "/ATTN Look",
        "  - one",
        "      - deeper"
      ],
      "want": [
        null,
        "ATTN",
        "ATTN"
      ]
    },
    {
      "name": "finds the owner when asked about the middle of a group",
      "lines": [
        "/DONE Shipped",
        "  - one",
        "  - two",
        "  - three"
      ],
      "from": 3,
      "to": 4,
      "want": [
        "DONE",
        "DONE"
      ]
    },
    {
      "name": "does not invent an owner from a group that already closed",
      "lines": [
        "/DONE Shipped",
        "  - one",
        "prose at the margin",
        "  - orphan"
      ],
      "from": 4,
      "to": 4,
      "want": [
        null
      ]
    }
  ],
  "priority": {
    "_comment": "Priority bangs glued to the tag: /TODO!, /TODO!!, /TODO!!!. level 0 = none. Four bangs or a space before them is not a priority. `step`: ⌃⌘↑ / ⌃⌘↓ (delta ±1) over [from, to] with the same line rule as the rotation; clamped to 0…3; lines without a tag are left alone.",
    "tags": [
      {
        "line": "/TODO!! x",
        "word": "TODO",
        "level": 2
      },
      {
        "line": "/WIP!!! x",
        "word": "WIP",
        "level": 3
      },
      {
        "line": "  /DONE! ",
        "word": "DONE",
        "level": 1
      },
      {
        "line": "/TODO x",
        "word": "TODO",
        "level": 0
      },
      {
        "line": "/TODO !! x",
        "word": "TODO",
        "level": 0
      },
      {
        "line": "/ATTN!!!",
        "word": "ATTN",
        "level": 3
      }
    ],
    "notTags": [
      "/TODO!!!! x",
      "/TODO!x",
      "/TODOS! x",
      "/TODO!!!!",
      "!/TODO x"
    ],
    "rotate": [
      {
        "line": "/TODO!! a",
        "after": "/DOING!! a"
      },
      {
        "line": "/WIP!!! a",
        "after": "/PAUSE!!! a"
      },
      {
        "line": "/CANCEL! a",
        "after": "a"
      },
      {
        "line": "  /ATTN!! a",
        "after": "  /DONE!! a"
      },
      {
        "line": "/TODO!!",
        "after": "/DOING!!"
      }
    ],
    "click": [
      {
        "line": "/TODO!!! a",
        "alt": false,
        "after": "/DONE!!! a"
      },
      {
        "line": "/DONE! a",
        "alt": false,
        "after": "/TODO! a"
      },
      {
        "line": "/PAUSE!! a",
        "alt": true,
        "after": "/WAIT!! a"
      }
    ],
    "step": [
      {
        "name": "up from none",
        "doc": "/TODO a",
        "from": 0,
        "to": 0,
        "delta": 1,
        "after": "/TODO! a"
      },
      {
        "name": "up keeps the word as written",
        "doc": "  /WIP!! a",
        "from": 4,
        "to": 4,
        "delta": 1,
        "after": "  /WIP!!! a"
      },
      {
        "name": "up stops at three",
        "doc": "/DOING!!! a",
        "from": 0,
        "to": 0,
        "delta": 1,
        "after": "/DOING!!! a"
      },
      {
        "name": "down from three",
        "doc": "/ATTN!!! a",
        "from": 0,
        "to": 0,
        "delta": -1,
        "after": "/ATTN!! a"
      },
      {
        "name": "down stops at none",
        "doc": "/DONE a",
        "from": 0,
        "to": 0,
        "delta": -1,
        "after": "/DONE a"
      },
      {
        "name": "a tag with no text",
        "doc": "/TODO!",
        "from": 0,
        "to": 0,
        "delta": 1,
        "after": "/TODO!!"
      },
      {
        "name": "an untagged line is left alone",
        "doc": "buy milk",
        "from": 0,
        "to": 0,
        "delta": 1,
        "after": "buy milk"
      },
      {
        "name": "a selection moves every tagged line, skips the rest",
        "doc": "/TODO a\nplain\n/DOING!! b\n\n/DONE!!! c",
        "from": 0,
        "to": 26,
        "delta": 1,
        "after": "/TODO! a\nplain\n/DOING!!! b\n\n/DONE!!! c"
      },
      {
        "name": "a selection ending at column 0 leaves that line out",
        "doc": "/TODO a\n/TODO b",
        "from": 0,
        "to": 8,
        "delta": 1,
        "after": "/TODO! a\n/TODO b"
      },
      {
        "name": "a cursor at column 0 still acts on its line",
        "doc": "/TODO a\n/TODO b",
        "from": 8,
        "to": 8,
        "delta": 1,
        "after": "/TODO a\n/TODO! b"
      }
    ]
  },
  "enter": {
    "_comment": "Enter on a line: col is the UTF-16 cursor column. continue → insert \"\\n\"+prefix at the cursor; exit → delete [from,to) of the line and stay; newline → the editor's plain newline.",
    "cases": [
      {
        "line": "/TODO buy milk",
        "col": 14,
        "kind": "continue",
        "prefix": "/TODO "
      },
      {
        "line": "/DONE! shipped",
        "col": 14,
        "kind": "continue",
        "prefix": "/TODO "
      },
      {
        "line": "  /DOING nested task",
        "col": 20,
        "kind": "continue",
        "prefix": "  /TODO "
      },
      {
        "line": "/TODO split here",
        "col": 11,
        "kind": "continue",
        "prefix": "/TODO "
      },
      {
        "line": "/TODO ",
        "col": 6,
        "kind": "exit",
        "from": 0,
        "to": 6
      },
      {
        "line": "  /WAIT!! ",
        "col": 10,
        "kind": "exit",
        "from": 2,
        "to": 10
      },
      {
        "line": "/TODO",
        "col": 5,
        "kind": "exit",
        "from": 0,
        "to": 5
      },
      {
        "line": "/TODO buy milk",
        "col": 3,
        "kind": "newline"
      },
      {
        "line": "/TODO buy milk",
        "col": 0,
        "kind": "newline"
      },
      {
        "line": "- dash item",
        "col": 11,
        "kind": "continue",
        "prefix": "- "
      },
      {
        "line": "  * nested star",
        "col": 15,
        "kind": "continue",
        "prefix": "  * "
      },
      {
        "line": "3. third",
        "col": 8,
        "kind": "continue",
        "prefix": "4. "
      },
      {
        "line": "- ",
        "col": 2,
        "kind": "exit",
        "from": 0,
        "to": 2
      },
      {
        "line": "  1. ",
        "col": 5,
        "kind": "exit",
        "from": 2,
        "to": 5
      },
      {
        "line": "- dash item",
        "col": 1,
        "kind": "newline"
      },
      {
        "line": "plain text",
        "col": 10,
        "kind": "newline"
      },
      {
        "line": "# heading",
        "col": 9,
        "kind": "newline"
      },
      {
        "line": "",
        "col": 0,
        "kind": "newline"
      },
      {
        "line": "/TODOS not a tag",
        "col": 16,
        "kind": "newline"
      }
    ]
  }
}
